# Copy to .env and fill in values before running install.sh
# Never commit .env — it contains real secrets.

# ── Required: set before first boot ──────────────────────────────────────
PRIMARY_DOMAIN=platform.example.com
MAIL_DOMAIN=mail.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-chars

# ── Auto-generated by install.sh (leave blank, filled in automatically) ──
DB_PASSWORD=
AUTHENTIK_DB_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_TOKEN=
OAUTH_CLIENT_SECRET=

# ── Mailcow API key (auto-generated or set manually after Mailcow starts) ─
MAILCOW_API_KEY=

# ── Optional overrides ────────────────────────────────────────────────────
TIMEZONE=UTC
DATABASE_SSL=false

# Service-to-service secret (portal → API). Generated by install.sh.
INTERNAL_API_SECRET=

# ── Immich (foto-archief) ────────────────────────────────────────────────
IMMICH_DB_PASS=
IMMICH_JWT_SECRET=

# ── Radicale (CalDAV) — URL is internal; no auth needed (network-isolated) ─
RADICALE_URL=http://radicale:5232

# ── LDAP / Authentik identity cache ──────────────────────────────────────
# LDAP outpost is served by Authentik on port 3389 (mapped to host 389).
# LdapMetadataService uses the Authentik REST API + Redis cache (TTL 5 min).
# QUEUE_REDIS_URL is shared with BullMQ — no separate Redis needed.
QUEUE_REDIS_URL=redis://queue-redis:6379
# MAIL_IMAP_HOST overrides the Paperless mail account IMAP server.
# Defaults to 'dovecot-mailcow' (internal Docker hostname).
MAIL_IMAP_HOST=dovecot-mailcow

# ── Signal Bot ────────────────────────────────────────────────────────────
SIGNAL_API_URL=http://signal-api:8080
SIGNAL_SENDER=
SIGNAL_RECIPIENT=

# ── Paperless ─────────────────────────────────────────────────────────────
PAPERLESS_API_TOKEN=
PAPERLESS_SECRET_KEY=
PAPERLESS_OIDC_CLIENT_ID=paperless-ngx
PAPERLESS_OIDC_CLIENT_SECRET=

# ── Webhook ───────────────────────────────────────────────────────────────
AUTHENTIK_WEBHOOK_SECRET=

# ── Web Push Notifications (generate with: npx web-push generate-vapid-keys) ─
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Immich ────────────────────────────────────────────────────────────────
IMMICH_DB_PASS=immich_secret
IMMICH_JWT_SECRET=changeme_immich_jwt
IMMICH_API_KEY=

# ── Ollama AI model ───────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.2

# ── Redis for queue workers ───────────────────────────────────────────────
QUEUE_REDIS_URL=redis://queue-redis:6379
