# Copy to .env for local development.
# In production these are set via docker-compose.yml environment block.

# PostgreSQL connection string
DATABASE_URL=postgresql://platform:password@localhost:5432/platform

# Allow requests from the portal dev server
PORTAL_ORIGIN=http://localhost:3000

# Service URLs (defaults match docker-compose service names)
AUTHENTIK_URL=http://localhost:9000
MAILCOW_URL=http://localhost:8080
MAILCOW_API_KEY=

# Directory where Traefik dynamic config is written during provisioning
TRAEFIK_CONFIG_DIR=/tmp/traefik-dev

# Set to true if your Postgres instance requires SSL
DATABASE_SSL=false

PORT=3001
