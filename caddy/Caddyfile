# Paperless-ngx (document management)
docs.platform.cbrains.de {
    reverse_proxy paperless:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
    }
}

# Authentik (SSO / identity provider)
auth.platform.cbrains.de {
    reverse_proxy authentik-server:9000 {
        header_up X-Forwarded-Proto https
    }
}

# Platform Portal (beschermd met Authentik forward auth)
portal.platform.cbrains.de {
    @public path /logo.svg /favicon.ico
    @static path_regexp ^\/_next\/(static|image)\/
    @api path /api/*

    handle @public {
        reverse_proxy portal:3000
    }

    handle @static {
        reverse_proxy portal:3000
    }

    handle @api {
        uri strip_prefix /api
        reverse_proxy api:3001
    }

    handle {
        forward_auth authentik-server:9000 {
            uri /outpost.goauthentik.io/auth/caddy
            copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid
        }
        reverse_proxy portal:3000
    }
}

# Mailcow webmail interface (nginx-mailcow listens on 8080 internally)
mail.cbrains.de {
    reverse_proxy nginx-mailcow:8080 {
        header_up X-Forwarded-Proto https
    }
}

# Radicale CalDAV/CardDAV
cal.platform.cbrains.de {
    forward_auth authentik-server:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid
    }
    reverse_proxy radicale:5232
}

# Immich (foto archief)
fotos.platform.cbrains.de {
    reverse_proxy immich-server:2283 {
        header_up X-Forwarded-Proto https
    }
}

# Paperless-GPT (AI auto-tagging)
gpt.platform.cbrains.de {
    forward_auth authentik-server:9000 {
        uri /outpost.goauthentik.io/auth/caddy
        copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid
    }
    reverse_proxy paperless-gpt:8080
}
